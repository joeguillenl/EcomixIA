<appSettings>
  <!-- Configure su clave autorizada de Azure Container Apps (X-API-Key) para pruebas locales -->
  <!-- Copie este archivo como 'Web.Secrets.config' (ignorado por Git) y coloque su clave real -->
  <add key="EcoMix:ApiKey" value="SU_CLAVE_AQUI" />
  <!-- Banderas opcionales para pruebas de registro en desarrollo local (ignorado en producción) -->
  <!-- <add key="EcoMix:EnableRegistrationTesting" value="true" /> -->
  <!-- <add key="EcoMix:AllowLocalMainDbRegistration" value="true" /> -->
</appSettings>
