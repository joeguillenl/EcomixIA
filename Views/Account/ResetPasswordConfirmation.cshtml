@{
    ViewBag.Title = "Contraseña restablecida";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 text-center p-4" style="border-radius: 12px;">
            <div class="my-3">
                <span class="badge bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-shield-check fs-1" aria-hidden="true"></i>
                </span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-3">Contraseña restablecida exitosamente</h1>
            <p class="text-secondary mb-4 px-md-3">
                Su contraseña ha sido actualizada. Por motivos de seguridad, las sesiones anteriores han sido cerradas. Ya puede ingresar con sus nuevas credenciales.
            </p>
            <div>
                <a href="@Url.Action("Login", "Account")" class="btn btn-primary px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión Ahora
                </a>
            </div>
        </div>
    </div>
</div>
