﻿@{
    ViewBag.Title = "Cuenta bloqueada";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="card-body">
                <div class="display-4 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
                <h1 class="h3 fw-bold mb-3 text-danger">Cuenta temporalmente bloqueada</h1>
                <div class="alert alert-danger my-4 text-start small" role="alert">
                    Por motivos de seguridad perimetral contra ataques de fuerza bruta (SRS v1.2 / RF-07), esta cuenta ha sido bloqueada temporalmente tras superar el límite de <strong>5 intentos fallidos consecutivos</strong>.
                </div>
                <p class="text-secondary small mb-4">
                    Por favor espere <strong>5 minutos</strong> antes de volver a intentar el inicio de sesión con sus credenciales correctas.
                </p>
                <div class="d-grid gap-2 col-md-8 mx-auto">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>
