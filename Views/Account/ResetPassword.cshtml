@model EcomixIA.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer contraseña";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-header bg-primary text-white py-3">
                <h1 class="h4 mb-0 fw-semibold"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Restablecer contraseña</h1>
            </div>
            <div class="card-body p-4">
                <p class="text-secondary small mb-4">
                    Ingrese su correo electrónico y defina su nueva contraseña.
                </p>

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Code)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "usuario@virtual.upt.pe", autocomplete = "email", autofocus = "autofocus", required = "required" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 8 caracteres (A-Z, a-z, 0-9, símbolo)", autocomplete = "new-password", required = "required" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repita la nueva contraseña", autocomplete = "new-password", required = "required" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Guardar nueva contraseña
                        </button>
                    </div>
                }
            </div>
            <div class="card-footer bg-light py-3 text-center small">
                <a href="@Url.Action("Login", "Account")" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Cancelar y volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</div>
