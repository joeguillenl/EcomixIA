﻿@model EcomixIA.Models.RegisterViewModel
@{
    ViewBag.Title = "Registrarse";
}

<div class="row justify-content-center my-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h1 class="h4 mb-0 fw-semibold">Crear una cuenta en EcoMix IA</h1>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                    <div>
                        <strong>Dominios autorizados:</strong> Por políticas de seguridad institucional, solo se admiten correos de la Universidad Privada de Tacna (<code>@@upt.pe</code>, <code>@@virtual.upt.pe</code>) o cuentas de investigación y docencia (<code>@@gmail.com</code>).
                    </div>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ejemplo@virtual.upt.pe", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 8 caracteres", autocomplete = "new-password" })
                        <div class="form-text small">La contraseña debe incluir al menos 8 caracteres, mayúscula, minúscula, dígito y un carácter especial.</div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repita su contraseña", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Registrarme</button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Volver al inicio</a>
                    </div>
                }
            </div>
            <div class="card-footer bg-light py-3 text-center text-muted small">
                Al registrarse se le asignará el rol de usuario <strong>Registrado</strong> tras confirmar su correo electrónico.
            </div>
        </div>
    </div>
</div>
