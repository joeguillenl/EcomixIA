@{
    ViewBag.Title = "EcoMix IA — Plataforma de Concreto Sostenible";
}

<!-- ==========================================================================
     SECCIÓN 1: HERO PROMOCIONAL (ETAPA 2)
     ========================================================================== -->
<section class="hero-promo mb-5" aria-labelledby="hero-title">
    <div class="hero-promo-content">
        <div class="d-inline-flex align-items-center gap-2 mb-3">
            <span class="badge hero-badge">
                <i class="bi bi-layers-half me-1" aria-hidden="true"></i>Plataforma de Ingeniería
            </span>
            <span class="badge hero-badge-secondary d-none d-sm-inline-block">
                Demostración Académica Local
            </span>
        </div>
        <h1 id="hero-title" class="hero-promo-title display-5 fw-bold mb-2">
            EcoMix <span class="text-accent-green">IA</span>
        </h1>
        <p class="hero-promo-subtitle fs-4 fw-semibold text-light-emerald mb-3">
            Diseño inteligente de mezclas de concreto sostenible.
        </p>
        <p class="hero-promo-desc fs-5 text-slate-200 mb-4">
            EcoMix IA integra herramientas para el diseño de mezclas de concreto, la estimación de costos y emisiones de CO₂, y la predicción de resistencia mediante inteligencia artificial.
        </p>
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <a href="#funcionalidades" class="btn btn-ecomix-primary btn-lg px-4 py-2 fw-semibold">
                <i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"></i>Conocer funcionalidades
            </a>
            <a href="@Url.Action("Simulador", "Mezclas")" class="btn btn-outline-ecomix-light btn-lg px-4 py-2 fw-semibold">
                <i class="bi bi-cpu me-2" aria-hidden="true"></i>Explorar simulador IA
            </a>
        </div>
        <div class="mt-3 text-slate-300 small d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-success" aria-hidden="true"></i>
            <span>Acceso en modo demostración local verificado (sin autenticación requerida en Fase 1).</span>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECCIÓN 1B: CARRUSEL INFORMATIVO CON IMÁGENES ORIGINALES (F1.3)
     ========================================================================== -->
<section class="ecomix-carousel-section mb-5" aria-labelledby="carousel-heading">
    <h2 id="carousel-heading" class="visually-hidden">Galería destacada de capacidades de EcoMix IA</h2>

    <div id="carruselPromocional" class="carousel slide ecomix-carousel shadow-sm" data-bs-ride="false" data-bs-touch="true" data-bs-keyboard="true" role="region" aria-roledescription="carousel" aria-label="Galería interactiva de capacidades">
        <!-- Indicadores de diapositiva -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carruselPromocional" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Diapositiva 1: Innovación en concreto sostenible"></button>
            <button type="button" data-bs-target="#carruselPromocional" data-bs-slide-to="1" aria-label="Diapositiva 2: Materiales y sostenibilidad"></button>
            <button type="button" data-bs-target="#carruselPromocional" data-bs-slide-to="2" aria-label="Diapositiva 3: Predicción de resistencia con IA"></button>
        </div>

        <!-- Diapositivas -->
        <div class="carousel-inner">
            <!-- Diapositiva 1: Innovación en concreto sostenible -->
            <div class="carousel-item active" role="group" aria-roledescription="slide" aria-label="1 de 3: Innovación en concreto sostenible">
                <img src="@Url.Content("~/Content/images/carousel/01-innovacion-concreto.webp")" class="d-block w-100 ecomix-carousel-img" alt="Dosificación y mezclado de probetas de concreto sostenible en laboratorio de ingeniería civil" width="1672" height="941" loading="eager" />
                <div class="carousel-caption ecomix-carousel-caption text-start">
                    <span class="badge ecomix-carousel-badge mb-2">Innovación &middot; Formulación</span>
                    <h3 class="ecomix-carousel-title display-6 fw-bold text-white mb-2">Innovación en concreto sostenible</h3>
                    <p class="ecomix-carousel-desc fs-5 text-slate-200 mb-3">Diseña mezclas, evalúa sus indicadores y explora herramientas de predicción con inteligencia artificial.</p>
                    <a href="#funcionalidades" class="btn btn-ecomix-primary btn-sm px-3 py-2 fw-semibold">
                        <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>Conocer funcionalidades
                    </a>
                </div>
            </div>

            <!-- Diapositiva 2: Materiales y sostenibilidad -->
            <div class="carousel-item" role="group" aria-roledescription="slide" aria-label="2 de 3: Materiales y sostenibilidad">
                <img src="@Url.Content("~/Content/images/carousel/02-materiales-sostenibles.webp")" class="d-block w-100 ecomix-carousel-img" alt="Muestras de adiciones puzolánicas y áridos minerales para reducción de huella de carbono" width="1672" height="941" loading="lazy" />
                <div class="carousel-caption ecomix-carousel-caption text-start">
                    <span class="badge ecomix-carousel-badge mb-2">Materiales &middot; Huella CO₂</span>
                    <h3 class="ecomix-carousel-title display-6 fw-bold text-white mb-2">Materiales y sostenibilidad</h3>
                    <p class="ecomix-carousel-desc fs-5 text-slate-200 mb-3">Analiza los costos y las emisiones estimadas de CO₂ de cada dosificación.</p>
                    <a href="#funcionalidades" class="btn btn-ecomix-primary btn-sm px-3 py-2 fw-semibold">
                        <i class="bi bi-layers-half me-1" aria-hidden="true"></i>Explorar funcionalidades
                    </a>
                </div>
            </div>

            <!-- Diapositiva 3: Predicción con inteligencia artificial -->
            <div class="carousel-item" role="group" aria-roledescription="slide" aria-label="3 de 3: Predicción de resistencia con IA">
                <img src="@Url.Content("~/Content/images/carousel/03-resistencia-concreto.webp")" class="d-block w-100 ecomix-carousel-img" alt="Ensayo de compresión axial en máquina universal de ensayo para probetas cilíndricas" width="1672" height="941" loading="lazy" />
                <div class="carousel-caption ecomix-carousel-caption text-start">
                    <span class="badge ecomix-carousel-badge mb-2">Machine Learning &middot; Resistencia</span>
                    <h3 class="ecomix-carousel-title display-6 fw-bold text-white mb-2">Predicción de resistencia con IA</h3>
                    <p class="ecomix-carousel-desc fs-5 text-slate-200 mb-3">Consulta estimaciones de resistencia a compresión a 7 y 28 días.</p>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <a href="@Url.Action("Simulador", "Mezclas")" class="btn btn-ecomix-primary btn-sm px-3 py-2 fw-semibold">
                            <i class="bi bi-cpu me-1" aria-hidden="true"></i>Explorar simulador IA
                        </a>
                        <span class="badge bg-secondary-subtle text-secondary small border">Demostración Local</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Controles de navegación manual anterior/siguiente -->
        <button class="carousel-control-prev ecomix-carousel-control" type="button" data-bs-target="#carruselPromocional" data-bs-slide="prev" aria-label="Diapositiva anterior">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next ecomix-carousel-control" type="button" data-bs-target="#carruselPromocional" data-bs-slide="next" aria-label="Diapositiva siguiente">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</section>

<!-- ==========================================================================
     SECCIÓN 2: FUNCIONALIDADES PRINCIPALES (ETAPA 3)
     ========================================================================== -->
<section id="funcionalidades" class="mb-5 pt-3" aria-labelledby="funcionalidades-title">
    <div class="text-center mb-4">
        <span class="section-kicker">Capacidades del Sistema</span>
        <h2 id="funcionalidades-title" class="h2 fw-bold text-navy-dark mt-1">Funcionalidades principales</h2>
        <p class="text-secondary mx-auto" style="max-width: 65ch;">
            Herramientas integradas para la gestión técnica, evaluación de sostenibilidad y análisis predictivo de mezclas de concreto.
        </p>
    </div>

    <div class="row g-4">
        <!-- Tarjeta 1: Catálogo de materiales -->
        <div class="col-md-4">
            <div class="card h-100 feature-card shadow-sm border">
                <div class="card-body d-flex flex-column p-4">
                    <div class="feature-icon feature-icon-green mb-3" aria-hidden="true">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h3 class="h5 fw-bold text-navy-dark card-title mb-2">Catálogo de materiales</h3>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        Gestión completa de insumos y sus propiedades físicas, económicas y ambientales: cementos portland, adiciones puzolánicas, agregados finos y gruesos, agua y aditivos. Permite registrar densidades, costos unitarios por kg y factores de emisión de CO₂ por material.
                    </p>
                    <a href="@Url.Action("Index", "Materiales")" class="btn btn-outline-primary w-100 fw-semibold mt-auto">
                        <i class="bi bi-box-seam me-1" aria-hidden="true"></i>Consultar materiales
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Diseño y evaluación de mezclas -->
        <div class="col-md-4">
            <div class="card h-100 feature-card shadow-sm border">
                <div class="card-body d-flex flex-column p-4">
                    <div class="feature-icon feature-icon-navy mb-3" aria-hidden="true">
                        <i class="bi bi-layers-half"></i>
                    </div>
                    <h3 class="h5 fw-bold text-navy-dark card-title mb-2">Diseño y evaluación de mezclas</h3>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        Registro de dosificaciones por metro cúbico (m³), balance volumétrico de componentes y estimación transparente de costos unitarios y emisiones de CO₂ acumuladas a partir de los materiales seleccionados.
                    </p>
                    <a href="@Url.Action("Index", "Mezclas")" class="btn btn-outline-primary w-100 fw-semibold mt-auto">
                        <i class="bi bi-stack me-1" aria-hidden="true"></i>Ver mezclas diseñadas
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Predicción mediante IA -->
        <div class="col-md-4">
            <div class="card h-100 feature-card shadow-sm border">
                <div class="card-body d-flex flex-column p-4">
                    <div class="feature-icon feature-icon-tech mb-3" aria-hidden="true">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <h3 class="h5 fw-bold text-navy-dark card-title mb-2">Predicción mediante IA</h3>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        Estimación asistida de la resistencia a la compresión a 7 y 28 días a través de un servicio de Machine Learning (modelo AutoML VotingEnsemble integrado vía FastAPI), facilitando el análisis preliminar de comportamiento mecánico.
                    </p>
                    <a href="@Url.Action("Simulador", "Mezclas")" class="btn btn-primary w-100 fw-semibold mt-auto">
                        <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Probar simulador IA
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECCIÓN 3: CÓMO FUNCIONA (ETAPA 4)
     ========================================================================== -->
<section id="como-funciona" class="mb-5 pt-3" aria-labelledby="como-funciona-title">
    <div class="text-center mb-4">
        <span class="section-kicker">Flujo de Trabajo</span>
        <h2 id="como-funciona-title" class="h2 fw-bold text-navy-dark mt-1">¿Cómo funciona EcoMix IA?</h2>
        <p class="text-secondary mx-auto" style="max-width: 68ch;">
            Un proceso técnico en tres pasos que combina cálculos cuantitativos de dosificación con inferencia predictiva de Machine Learning.
        </p>
    </div>

    <div class="row g-4">
        <!-- Paso 1 -->
        <div class="col-md-4">
            <div class="step-card h-100 border p-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="step-badge">Paso 01</span>
                    <div class="step-icon" aria-hidden="true">
                        <i class="bi bi-search"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold text-navy-dark mb-2">Consultar materiales y características</h3>
                <p class="text-secondary mb-0">
                    Explore los insumos disponibles en el catálogo global: tipos de cemento, agregados, adiciones minerales y aditivos, revisando sus propiedades físicas, costo unitario por kg y factor de emisión de CO₂ asociado.
                </p>
            </div>
        </div>

        <!-- Paso 2 -->
        <div class="col-md-4">
            <div class="step-card h-100 border p-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="step-badge">Paso 02</span>
                    <div class="step-icon" aria-hidden="true">
                        <i class="bi bi-sliders"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold text-navy-dark mb-2">Configurar dosificación de concreto</h3>
                <p class="text-secondary mb-0">
                    Defina las proporciones de agua, cemento, adiciones puzolánicas y agregados para un volumen de 1 m³ de concreto, adaptando la formulación a los requerimientos de resistencia y trabajabilidad del proyecto.
                </p>
            </div>
        </div>

        <!-- Paso 3 -->
        <div class="col-md-4">
            <div class="step-card h-100 border p-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="step-badge">Paso 03</span>
                    <div class="step-icon" aria-hidden="true">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <h3 class="h5 fw-bold text-navy-dark mb-2">Evaluar indicadores y predicciones</h3>
                <p class="text-secondary mb-0">
                    Analice el balance de masa, costo por m³ y emisiones de CO₂ mediante <strong>cálculos convencionales</strong>, y consulte las estimaciones de resistencia a 7 y 28 días generadas por el <strong>modelo predictivo de Machine Learning</strong>.
                </p>
            </div>
        </div>
    </div>

    <!-- Nota discreta de prototipo académico (Tarea 4) -->
    <div class="text-center mt-4 pt-2">
        <p class="text-secondary small mb-0">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>EcoMix IA es un prototipo académico. Sus estimaciones son orientativas y no sustituyen ensayos de laboratorio.
        </p>
    </div>
</section>
