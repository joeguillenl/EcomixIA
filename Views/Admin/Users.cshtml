@model EcomixIA.Models.ViewModels.AdminUsersListViewModel
@{
    ViewBag.Title = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <!-- Encabezado de Gestión de Usuarios -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h2 text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i> Gestión y Control de Acceso de Usuarios
            </h1>
            <p class="text-muted mb-0">Administración de cuentas, asignación de roles (RBAC) y control de habilitación (RF-21, RF-22, RF-23).</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
            </a>
        </div>
    </div>

    <!-- Mensajes de Éxito o Error -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["MensajeError"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Barra de Búsqueda y Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("Users", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
            {
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchEmail" class="form-control" placeholder="Buscar por correo electrónico..." value="@Model.SearchEmail" />
                        <button type="submit" class="btn btn-primary">Buscar</button>
                    </div>
                </div>
                if (!string.IsNullOrWhiteSpace(Model.SearchEmail))
                {
                    <div class="col-auto">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Limpiar filtro
                        </a>
                    </div>
                }
                <div class="col-auto ms-auto text-muted small">
                    Mostrando <strong>@Model.Users.Count</strong> de <strong>@Model.TotalUsers</strong> usuarios registrados
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="min-width: 220px;">Usuario / Correo</th>
                            <th scope="col" style="width: 140px;">Rol Actual</th>
                            <th scope="col" style="width: 120px;">Estado</th>
                            <th scope="col" style="width: 130px;">Confirmación</th>
                            <th scope="col" style="width: 120px;">Seguridad</th>
                            <th scope="col" style="min-width: 240px;" class="text-end">Acciones Administrativas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users != null && Model.Users.Any())
                        {
                            foreach (var u in Model.Users)
                            {
                                bool isSelf = (u.UserId == Model.CurrentUserId);
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle bg-primary bg-opacity-10 text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                @(string.IsNullOrEmpty(u.Email) ? "?" : u.Email.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @u.Email
                                                    @if (isSelf)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary ms-1">Tú</span>
                                                    }
                                                </div>
                                                <div class="text-muted small">ID: <code class="text-secondary small">@u.UserId.Substring(0, Math.Min(8, u.UserId.Length))...</code></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (u.IsAdministrator)
                                        {
                                            <span class="badge bg-warning text-dark fw-bold">
                                                <i class="bi bi-shield-fill me-1"></i> Administrador
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                <i class="bi bi-person me-1"></i> Registrado
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsEnabled)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i> Habilitado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-slash-circle me-1"></i> Inhabilitado
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.EmailConfirmed)
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="bi bi-envelope-check-fill me-1"></i> Confirmado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small fw-semibold">
                                                <i class="bi bi-envelope-exclamation-fill me-1"></i> Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">Bloqueado</span>
                                        }
                                        else if (u.AccessFailedCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@u.AccessFailedCount fallos</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Normal</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <!-- Botón de Habilitar / Inhabilitar Estado -->
                                            @using (Html.BeginForm("ToggleUserStatus", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("userId", u.UserId)
                                                if (u.IsEnabled)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            title="Inhabilitar cuenta (impedirá inicio de sesión)"
                                                            onclick="return confirm('¿Confirma que desea inhabilitar la cuenta @u.Email?');">
                                                        <i class="bi bi-person-x me-1"></i> Inhabilitar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" 
                                                            title="Habilitar cuenta"
                                                            onclick="return confirm('¿Confirma que desea habilitar la cuenta @u.Email?');">
                                                        <i class="bi bi-person-check me-1"></i> Habilitar
                                                    </button>
                                                }
                                            }

                                            <!-- Botón de Cambio de Rol (RBAC) -->
                                            @using (Html.BeginForm("ChangeUserRole", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("userId", u.UserId)
                                                if (u.IsAdministrator)
                                                {
                                                    @Html.Hidden("targetRole", "Registrado")
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" 
                                                            title="Revocar privilegios de administrador y asignar rol Registrado"
                                                            onclick="return confirm('¿Confirma que desea revocar el rol de Administrador a @u.Email?');">
                                                        <i class="bi bi-arrow-down-circle me-1"></i> A Registrado
                                                    </button>
                                                }
                                                else
                                                {
                                                    @Html.Hidden("targetRole", "Administrador")
                                                    <button type="submit" class="btn btn-sm btn-outline-warning text-dark" 
                                                            title="Promover usuario a Administrador"
                                                            onclick="return confirm('¿Confirma que desea promover a @u.Email como Administrador? Esta acción le otorgará privilegios completos de administración.');">
                                                        <i class="bi bi-shield-plus me-1"></i> A Administrador
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-person-slash fs-2 d-block mb-2 text-secondary"></i>
                                    No se encontraron cuentas de usuario con el criterio especificado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginador -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Página <strong>@Model.CurrentPage</strong> de <strong>@Model.TotalPages</strong></span>
                <nav aria-label="Navegación de páginas de usuarios">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Users", "Admin", new { searchEmail = Model.SearchEmail, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Anterior</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Users", "Admin", new { searchEmail = Model.SearchEmail, page = p, pageSize = Model.PageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Users", "Admin", new { searchEmail = Model.SearchEmail, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
