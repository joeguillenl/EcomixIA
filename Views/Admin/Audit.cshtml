@model EcomixIA.Models.ViewModels.AdminAuditListViewModel
@{
    ViewBag.Title = "Pistas de Auditoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <!-- Encabezado de Auditoría -->
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h2 text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-journal-text text-primary"></i> Pistas de Auditoría y Eventos de Seguridad
            </h1>
            <p class="text-muted mb-0">Trazabilidad de seguridad, accesos, modificaciones de roles y consultas ML protegidas (D-07, RF-49-51).</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <!-- Botón de Depuración Física Idempotente (RF-51) -->
            @using (Html.BeginForm("PurgeAudit", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" 
                        title="Eliminar físicamente registros de auditoría anteriores a 30 días"
                        onclick="return confirm('¿Confirma la depuración física de los eventos anteriores al corte de 30 días (@Model.RetentionCutoffUtc.ToString("dd/MM/yyyy HH:mm") UTC)? Esta acción es irreversible e idempotente.');">
                    <i class="bi bi-trash3 me-1"></i> Depurar Eventos Vencidos (>30d)
                </button>
            }
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Mensajes de Éxito o Error -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["MensajeError"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Alerta Informativa de Política de Retención -->
    <div class="alert alert-light border shadow-sm d-flex align-items-center justify-content-between p-3 mb-4">
        <div class="d-flex align-items-center gap-2 small text-muted">
            <i class="bi bi-shield-shaded text-primary fs-5"></i>
            <span>
                <strong>Corte de Retención Activo:</strong> @Model.RetentionCutoffUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC. 
                Los eventos anteriores están automáticamente excluidos de la vista y la analítica.
            </span>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Retención: 30 Días</span>
    </div>

    <!-- Filtros de Consulta -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("Audit", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Categoría</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Category))">Todas las categorías</option>
                        <option value="Seguridad" selected="@(Model.Category == "Seguridad")">Seguridad / Autenticación</option>
                        <option value="Admin" selected="@(Model.Category == "Admin")">Administración / RBAC</option>
                        <option value="ML" selected="@(Model.Category == "ML")">Machine Learning</option>
                        <option value="General" selected="@(Model.Category == "General")">General</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Resultado</label>
                    <select name="success" class="form-select form-select-sm">
                        <option value="" selected="@(!Model.SuccessFilter.HasValue)">Todos</option>
                        <option value="true" selected="@(Model.SuccessFilter == true)">Éxito</option>
                        <option value="false" selected="@(Model.SuccessFilter == false)">Fallo</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Búsqueda de texto</label>
                    <input type="text" name="searchTerm" class="form-control form-select-sm" placeholder="Acción, usuario o detalle..." value="@Model.SearchTerm" />
                </div>

                <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Category) || Model.SuccessFilter.HasValue || !string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Audit", "Admin")" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Pistas de Auditoría -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                Eventos Registrados (@Model.TotalEvents eventos encontrados)
            </h5>
            <span class="text-muted small">Página @Model.CurrentPage de @Model.TotalPages</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 font-monospace small">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 175px;">Fecha / Hora (UTC)</th>
                            <th scope="col" style="width: 110px;">Categoría</th>
                            <th scope="col" style="width: 160px;">Acción</th>
                            <th scope="col" style="width: 90px;">Estado</th>
                            <th scope="col" style="width: 180px;">Actor</th>
                            <th scope="col">Detalles (Sanitizados)</th>
                            <th scope="col" style="width: 120px;">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Events != null && Model.Events.Any())
                        {
                            foreach (var ev in Model.Events)
                            {
                                <tr>
                                    <td class="text-nowrap text-muted">@ev.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        <span class="badge @(ev.Category == "Seguridad" ? "bg-info" : ev.Category == "Admin" ? "bg-warning text-dark" : ev.Category == "ML" ? "bg-primary" : "bg-secondary")">
                                            @ev.Category
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">@ev.Action</td>
                                    <td>
                                        @if (ev.Success)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Éxito</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Fallo</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width: 180px;" title="@ev.ActorEmail">
                                        @(string.IsNullOrEmpty(ev.ActorEmail) ? "Sistema" : ev.ActorEmail)
                                    </td>
                                    <td class="text-break" style="font-family: inherit;">
                                        @ev.Details
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(ev.IpAddress) ? "-" : ev.IpAddress)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    No se encontraron eventos de auditoría que coincidan con los filtros aplicados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Mostrando página @Model.CurrentPage de @Model.TotalPages</span>
                <nav aria-label="Navegación de páginas de auditoría">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Audit", "Admin", new { category = Model.Category, success = Model.SuccessFilter, searchTerm = Model.SearchTerm, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Anterior</a>
                        </li>
                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Audit", "Admin", new { category = Model.Category, success = Model.SuccessFilter, searchTerm = Model.SearchTerm, page = p, pageSize = Model.PageSize })">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Audit", "Admin", new { category = Model.Category, success = Model.SuccessFilter, searchTerm = Model.SearchTerm, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
