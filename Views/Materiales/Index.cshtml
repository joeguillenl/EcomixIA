@model IEnumerable<EcomixIA.Models.Material>
@{
    ViewBag.Title = "Materiales";
}

<div class="page-header">
    <h1><i class="bi bi-box-seam"></i> Materiales</h1>
    @Html.ActionLink("Nuevo material", "Create", null, new { @class = "btn btn-primary" })
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Tipo)</th>
                    <th class="num">@Html.DisplayNameFor(m => m.CostoPorKg)</th>
                    <th class="num">@Html.DisplayNameFor(m => m.Co2PorKg)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td><span class="tag">@item.Tipo</span></td>
                        <td class="num">@item.CostoPorKg.ToString("0.000")</td>
                        <td class="num">@item.Co2PorKg.ToString("0.000")</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <p class="mb-2">Todavía no hay materiales registrados.</p>
            @Html.ActionLink("Registra el primero", "Create", null, new { @class = "btn btn-sm btn-primary" })
        </div>
    }
</div>
