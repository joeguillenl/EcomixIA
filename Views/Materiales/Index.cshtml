@model IEnumerable<EcomixIA.Models.Material>
@{
    ViewBag.Title = "Materiales";
}

<style>
    /* Estilos directos de Badges de Tipos de Materiales (Fase 3 UX) */
    .badge-tipo-cemento,
    .badge-tipo-adicion,
    .badge-tipo-agregado,
    .badge-tipo-agua,
    .badge-tipo-aditivo {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.35rem !important;
        padding: 0.25rem 0.75rem !important;
        border-radius: 9999px !important;
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        line-height: 1.25 !important;
        text-align: center !important;
        white-space: nowrap !important;
        text-decoration: none !important;
    }
    .badge-tipo-cemento {
        background-color: #DCFCE7 !important;
        color: #15803D !important;
        border: 1px solid #BBF7D0 !important;
    }
    .badge-tipo-adicion {
        background-color: #DBEAFE !important;
        color: #1D4ED8 !important;
        border: 1px solid #BFDBFE !important;
    }
    .badge-tipo-agregado {
        background-color: #FEF3C7 !important;
        color: #B45309 !important;
        border: 1px solid #FDE68A !important;
    }
    .badge-tipo-agua {
        background-color: #CCFBF1 !important;
        color: #0F766E !important;
        border: 1px solid #99F6E4 !important;
    }
    .badge-tipo-aditivo {
        background-color: #F3E8FF !important;
        color: #7E22CE !important;
        border: 1px solid #E9D5FF !important;
    }
</style>

@functions {
    string GetTipoBadgeClass(string tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo)) return "badge-tipo-cemento";
        string t = tipo.Trim().ToLowerInvariant();
        if (t.Contains("cemento")) return "badge-tipo-cemento";
        if (t.Contains("adici")) return "badge-tipo-adicion";
        if (t.Contains("agregad")) return "badge-tipo-agregado";
        if (t.Contains("agua")) return "badge-tipo-agua";
        if (t.Contains("aditiv")) return "badge-tipo-aditivo";
        return "badge-tipo-cemento";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-box-seam text-success fs-3" aria-hidden="true"></i>
        <h1 class="h2 mb-0 fw-bold">Materiales</h1>
    </div>
    @if (User != null && User.IsInRole("Administrador"))
    {
        @Html.ActionLink("Nuevo material", "Create", null, new { @class = "btn btn-primary px-4 fw-semibold" })
    }
</div>

<!-- Tarjeta de Leyenda: Tipos de materiales (Fase 3 UX) -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: #ffffff; border: 1px solid #e2e8f0 !important;">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-info-circle text-muted" aria-hidden="true"></i>
            <span class="fw-semibold text-dark">Tipos de materiales</span>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md">
                <div class="mb-1">
                    <span class="badge-tipo-cemento"><i class="bi bi-archive" aria-hidden="true"></i> Cemento</span>
                </div>
                <p class="text-secondary small mb-0" style="font-size: 0.78rem; line-height: 1.35;">
                    Material cementante principal (ej. cemento Portland, puzolánico).
                </p>
            </div>
            <div class="col-12 col-md">
                <div class="mb-1">
                    <span class="badge-tipo-adicion"><i class="bi bi-eyedropper" aria-hidden="true"></i> Adición</span>
                </div>
                <p class="text-secondary small mb-0" style="font-size: 0.78rem; line-height: 1.35;">
                    Material cementante suplementario (ej. ceniza volante, escoria, humo de sílice).
                </p>
            </div>
            <div class="col-12 col-md">
                <div class="mb-1">
                    <span class="badge-tipo-agregado"><i class="bi bi-pie-chart" aria-hidden="true"></i> Agregado</span>
                </div>
                <p class="text-secondary small mb-0" style="font-size: 0.78rem; line-height: 1.35;">
                    Material granular (ej. arena, grava o piedra chancada).
                </p>
            </div>
            <div class="col-12 col-md">
                <div class="mb-1">
                    <span class="badge-tipo-agua"><i class="bi bi-droplet" aria-hidden="true"></i> Agua</span>
                </div>
                <p class="text-secondary small mb-0" style="font-size: 0.78rem; line-height: 1.35;">
                    Agua de mezcla (ej. agua potable).
                </p>
            </div>
            <div class="col-12 col-md">
                <div class="mb-1">
                    <span class="badge-tipo-aditivo"><i class="bi bi-layers" aria-hidden="true"></i> Aditivo</span>
                </div>
                <p class="text-secondary small mb-0" style="font-size: 0.78rem; line-height: 1.35;">
                    Producto químico que modifica propiedades del concreto (ej. superplastificante).
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Materiales -->
<div class="table-panel shadow-sm" style="border-radius: 12px; border: 1px solid #e2e8f0; background: #fff; overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-secondary" style="border-bottom: 1px solid #e2e8f0;">
                <tr>
                    <th class="ps-4 py-3">Nombre</th>
                    <th class="py-3 text-center">Tipo</th>
                    <th class="py-3 text-center">Costo por kg</th>
                    <th class="py-3 text-center">Emisión de CO₂ por kg</th>
                    <th class="pe-4 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-semibold text-dark">@item.Nombre</td>
                        <td class="py-3 text-center">
                            <span class="@GetTipoBadgeClass(item.Tipo)">@item.Tipo</span>
                        </td>
                        <td class="py-3 text-center font-monospace">@item.CostoPorKg.ToString("0.000")</td>
                        <td class="py-3 text-center font-monospace">@item.Co2PorKg.ToString("0.000")</td>
                        <td class="pe-4 py-3 text-end text-nowrap">
                            @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary px-3 me-1" })
                            @if (User != null && User.IsInRole("Administrador"))
                            {
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-success px-3 me-1" })
                                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger px-3" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state py-5 text-center">
            <i class="bi bi-box-seam text-muted fs-1 mb-2"></i>
            <p class="mb-2 text-secondary">Todavía no hay materiales registrados.</p>
            @if (User != null && User.IsInRole("Administrador"))
            {
                @Html.ActionLink("Registra el primero", "Create", null, new { @class = "btn btn-sm btn-primary" })
            }
        </div>
    }
</div>
