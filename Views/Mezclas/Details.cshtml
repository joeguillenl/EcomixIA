﻿@model EcomixIA.Models.Mezcla
@{
    ViewBag.Title = "Detalles de la mezcla";
    var materiales = (SelectList)ViewBag.Materiales;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.Nombre</h1>
    <div class="d-flex flex-wrap gap-2">
        @Html.ActionLink("Simular con EcoMix IA", "Simulador", new { mezclaId = Model.Id }, new { @class = "btn btn-success" })
        @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-primary" })
        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-secondary small">@Html.DisplayNameFor(m => m.ResistenciaMPa)</div>
            <div class="fs-4 fw-semibold font-monospace">@Model.ResistenciaMPa.ToString("0.0") MPa</div>
            <div class="small text-muted mt-1">Edad: @Model.EdadDias días</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-secondary small">Costo por m³</div>
            @if (Model.TieneSnapshotsCompletos && Model.CostoHistoricoPorM3.HasValue)
            {
                <div class="fs-4 fw-semibold text-success font-monospace">S/ @Model.CostoHistoricoPorM3.Value.ToString("0.00")</div>
                <div class="badge bg-success-subtle text-success border border-success-subtle mt-1 small">
                    <i class="bi bi-shield-check me-1"></i>Snapshot Verificado (D-09)
                </div>
            }
            else
            {
                <div class="fs-6 fw-semibold text-secondary mt-1">Datos históricos pendientes de validar</div>
                <div class="small text-muted mt-1">
                    Estimado: S/ @Model.CostoReferencialActualPorM3.ToString("0.00")
                    <span class="badge text-bg-light border text-muted">Referencial</span>
                </div>
            }
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-secondary small">Emisiones de CO₂ por m³</div>
            @if (Model.TieneSnapshotsCompletos && Model.Co2HistoricoPorM3.HasValue)
            {
                <div class="fs-4 fw-semibold text-primary font-monospace">@Model.Co2HistoricoPorM3.Value.ToString("0.0") kg</div>
                <div class="badge bg-success-subtle text-success border border-success-subtle mt-1 small">
                    <i class="bi bi-shield-check me-1"></i>Snapshot Verificado (D-09)
                </div>
            }
            else
            {
                <div class="fs-6 fw-semibold text-secondary mt-1">Datos históricos pendientes de validar</div>
                <div class="small text-muted mt-1">
                    Estimado: @Model.Co2ReferencialActualPorM3.ToString("0.0") kg CO₂/m³
                    <span class="badge text-bg-light border text-muted">Referencial</span>
                </div>
            }
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-secondary small">@Html.DisplayNameFor(m => m.MasaTotalPorM3)</div>
            <div class="fs-4 fw-semibold font-monospace">@Model.MasaTotalPorM3.ToString("0.0") kg/m³</div>
            <div class="small text-muted mt-1">Suma de componentes</div>
        </div></div>
    </div>
</div>

<div class="bg-white rounded-3 border p-4 mb-4">
    <h2 class="h5 fw-semibold mb-3">Parámetros de diseño</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-secondary">@Html.DisplayNameFor(m => m.EdadDias)</dt>
        <dd class="col-sm-9 font-monospace">@Model.EdadDias días</dd>
        <dt class="col-sm-3 text-secondary">@Html.DisplayNameFor(m => m.RelacionAguaCemento)</dt>
        <dd class="col-sm-9 font-monospace">@(Model.RelacionAguaCemento.HasValue ? Model.RelacionAguaCemento.Value.ToString("0.00") : "—")</dd>
        <dt class="col-sm-3 text-secondary">@Html.DisplayNameFor(m => m.AsentamientoCm)</dt>
        <dd class="col-sm-9 font-monospace">@(Model.AsentamientoCm.HasValue ? Model.AsentamientoCm.Value.ToString("0.0") + " cm" : "—")</dd>
        <dt class="col-sm-3 text-secondary">@Html.DisplayNameFor(m => m.Notas)</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notas) ? "—" : Model.Notas)</dd>
    </dl>
</div>

<div class="bg-white rounded-3 border p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 fw-semibold mb-0">Materiales y Dosificación por m³</h2>
        @if (Model.TieneSnapshotsCompletos)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="bi bi-lock-fill me-1"></i>Precios y CO₂ Históricos Inmutables
            </span>
        }
        else
        {
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Contiene Componentes Legados
            </span>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-3">
            <thead class="table-light small text-uppercase text-secondary">
                <tr>
                    <th>Material</th>
                    <th>Tipo</th>
                    <th class="text-end">Cantidad (kg/m³)</th>
                    <th class="text-end">Costo Unit.</th>
                    <th class="text-end">CO₂ Unit.</th>
                    <th class="text-end">Costo Subtotal</th>
                    <th class="text-end">CO₂ Subtotal</th>
                    <th class="text-center">Estado Snapshot</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Componentes.OrderBy(c => c.Material.Tipo))
                {
                    <tr>
                        <td>
                            <strong>@c.Material.Nombre</strong>
                        </td>
                        <td><span class="badge text-bg-secondary">@c.Material.Tipo</span></td>
                        <td class="text-end font-monospace">
                            @c.Cantidad.ToString("0.0")
                        </td>
                        <td class="text-end font-monospace small">
                            @if (c.CostoPorKgGuardado.HasValue)
                            {
                                <span>S/ @c.CostoPorKgGuardado.Value.ToString("0.000000")</span>
                            }
                            else
                            {
                                <span class="text-muted" title="Precio no capturado históricamente">—</span>
                            }
                        </td>
                        <td class="text-end font-monospace small">
                            @if (c.Co2PorKgGuardado.HasValue)
                            {
                                <span>@c.Co2PorKgGuardado.Value.ToString("0.000000")</span>
                            }
                            else
                            {
                                <span class="text-muted" title="Factor no capturado históricamente">—</span>
                            }
                        </td>
                        <td class="text-end font-monospace">
                            @if (c.CostoPorKgGuardado.HasValue)
                            {
                                <span class="text-success fw-semibold">S/ @((c.Cantidad * c.CostoPorKgGuardado.Value).ToString("0.00"))</span>
                            }
                            else
                            {
                                <span class="text-muted small" title="Estimado referencial">Ref: S/ @((c.Cantidad * c.Material.CostoPorKg).ToString("0.00"))</span>
                            }
                        </td>
                        <td class="text-end font-monospace">
                            @if (c.Co2PorKgGuardado.HasValue)
                            {
                                <span class="text-primary fw-semibold">@((c.Cantidad * c.Co2PorKgGuardado.Value).ToString("0.0")) kg</span>
                            }
                            else
                            {
                                <span class="text-muted small" title="Estimado referencial">Ref: @((c.Cantidad * c.Material.Co2PorKg).ToString("0.0")) kg</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (c.OrigenSnapshot == "CAPTURADO")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle" title="Snapshot capturado en: @(c.FechaSnapshotUtc.HasValue ? c.FechaSnapshotUtc.Value.ToString("yyyy-MM-dd HH:mm UTC") : "—")">
                                    <i class="bi bi-shield-check me-1"></i>Capturado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="Componente preexistente no verificado">
                                    <i class="bi bi-clock-history me-1"></i>Legado
                                </span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @using (Html.BeginForm("EliminarComponente", "Mezclas", FormMethod.Post, new { @class = "d-inline m-0 p-0" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar componente de la mezcla">
                                    <i class="bi bi-trash" aria-hidden="true"></i> Quitar
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Componentes.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-4">Esta mezcla todavía no tiene materiales dosificados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @using (Html.BeginForm("AgregarComponente", "Mezclas", FormMethod.Post, new { @class = "row g-2 align-items-end pt-2 border-top" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="mezclaId" value="@Model.Id" />
        <div class="col-md-6">
            <label class="form-label small fw-semibold" for="MaterialId">Seleccionar Material a Dosificar</label>
            @Html.DropDownList("MaterialId", materiales, "-- Selecciona un material del catálogo --", new { @class = "form-select", id = "MaterialId", required = "required" })
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold" for="Cantidad">Cantidad (kg/m³)</label>
            <input type="number" step="any" min="0.01" max="5000" name="Cantidad" id="Cantidad" class="form-control font-monospace" placeholder="ej. 350.0" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-plus-lg me-1"></i>Agregar
            </button>
        </div>
    }
</div>
