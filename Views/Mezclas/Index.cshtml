@model IEnumerable<EcomixIA.Models.Mezcla>
@{
    ViewBag.Title = "Mis mezclas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-stack text-success fs-3" aria-hidden="true"></i>
            <h1 class="h2 mb-0 fw-bold">Mezclas</h1>
        </div>
        <p class="text-secondary small mb-0 mt-1">Tus fórmulas de concreto guardadas.</p>
    </div>
    <div class="d-flex gap-2">
        @Html.ActionLink("Simulador IA", "Simulador", null, new { @class = "btn btn-outline-success px-3 fw-semibold" })
        @if (Request.IsAuthenticated)
        {
            @Html.ActionLink("Nueva mezcla", "Create", null, new { @class = "btn btn-primary px-3 fw-semibold" })
        }
    </div>
</div>

<!-- Banner de Privacidad de Mezclas (Fase 3 UX) -->
<div class="alert alert-info d-flex align-items-center gap-2 mb-4" style="background-color: #e0f2fe; border: 1px solid #bae6fd; color: #0369a1; border-radius: 10px;" role="status">
    <i class="bi bi-shield-check fs-5" aria-hidden="true"></i>
    <span class="fw-medium">Tus mezclas son privadas y solo visibles para tu cuenta.</span>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Panel de Tabla de Mezclas -->
<div class="table-panel shadow-sm mb-3" style="border-radius: 12px; border: 1px solid #e2e8f0; background: #fff; overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-secondary" style="border-bottom: 1px solid #e2e8f0;">
                <tr>
                    <th class="ps-4 py-3">Nombre</th>
                    <th class="py-3 text-center">Resistencia f'c (MPa)</th>
                    <th class="py-3 text-center">Edad de diseño (días)</th>
                    <th class="py-3 text-center">Relación agua/cemento</th>
                    <th class="py-3 text-center">Costo por m³</th>
                    <th class="py-3 text-center">CO₂ por m³</th>
                    <th class="pe-4 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-semibold text-dark">@item.Nombre</td>
                        <td class="py-3 text-center font-monospace">@item.ResistenciaMPa.ToString("0.0")</td>
                        <td class="py-3 text-center font-monospace">@item.EdadDias</td>
                        <td class="py-3 text-center font-monospace">@(item.RelacionAguaCemento.HasValue ? item.RelacionAguaCemento.Value.ToString("0.00") : "—")</td>
                        <td class="py-3 text-center font-monospace">S/ @item.CostoPorM3.ToString("0.00")</td>
                        <td class="py-3 text-center font-monospace">@item.Co2PorM3.ToString("0.000")</td>
                        <td class="pe-4 py-3 text-end text-nowrap">
                            @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary px-2 me-1" })
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-success px-2 me-1" })
                            @Html.ActionLink("Duplicar", "Duplicar", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary px-2 me-1" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger px-2" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state py-5 text-center">
            <i class="bi bi-stack text-muted fs-1 mb-2"></i>
            @if (Request.IsAuthenticated)
            {
                <p class="mb-3 text-secondary">Aún no tienes mezclas guardadas. Crea tu primera mezcla o prueba con el Simulador IA.</p>
                <div class="d-flex justify-content-center gap-2">
                    @Html.ActionLink("Nueva mezcla", "Create", null, new { @class = "btn btn-sm btn-primary px-3" })
                    @Html.ActionLink("Simulador IA", "Simulador", null, new { @class = "btn btn-sm btn-outline-success px-3" })
                </div>
            }
            else
            {
                <p class="mb-3 text-secondary">Inicia sesión para gestionar y guardar tus fórmulas privadas de concreto.</p>
                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                </a>
            }
        </div>
    }
</div>

<div class="d-flex align-items-center gap-2 text-secondary small ps-1">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    <span>Solo ves las mezclas de tu cuenta.</span>
</div>
