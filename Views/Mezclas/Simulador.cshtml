@model EcomixIA.Models.ViewModels.SimuladorDosificacionViewModel
@{
    ViewBag.Title = "Simulador IA";

    // Cálculo inicial para renderizado del gráfico SVG en POST tradicional
    decimal? initP7 = Model.Resultado?.Predictions?.Strength7dMpa;
    decimal? initP28 = Model.Resultado?.Predictions?.Strength28dMpa;
    decimal p7Num = initP7 ?? 0m;
    decimal p28Num = initP28 ?? 0m;
    decimal maxScale = Math.Max(50m, Math.Ceiling(Math.Max(p7Num, p28Num) / 10m) * 10m);
    decimal plotH = 144m; // De y=35 hasta y=179
    decimal h7Init = (initP7.HasValue && maxScale > 0) ? (initP7.Value / maxScale) * plotH : 0m;
    decimal h28Init = (initP28.HasValue && maxScale > 0) ? (initP28.Value / maxScale) * plotH : 0m;
    decimal y7Init = 179m - h7Init;
    decimal y28Init = 179m - h28Init;
}

<style>
    /* Estilos directos de Badges para Guía rápida de componentes (Fase 3 UX) */
    .badge-sim-cemento,
    .badge-sim-agua,
    .badge-sim-escoria,
    .badge-sim-ceniza,
    .badge-sim-agregado,
    .badge-sim-aditivo {
        display: inline-block !important;
        padding: 0.18rem 0.55rem !important;
        border-radius: 9999px !important;
        font-size: 0.72rem !important;
        font-weight: 600 !important;
        line-height: 1.2 !important;
        text-align: center !important;
        white-space: nowrap !important;
        text-decoration: none !important;
    }
    .badge-sim-cemento {
        background-color: #DCFCE7 !important;
        color: #15803D !important;
        border: 1px solid #BBF7D0 !important;
    }
    .badge-sim-agua {
        background-color: #CCFBF1 !important;
        color: #0F766E !important;
        border: 1px solid #99F6E4 !important;
    }
    .badge-sim-escoria {
        background-color: #FEF3C7 !important;
        color: #B45309 !important;
        border: 1px solid #FDE68A !important;
    }
    .badge-sim-ceniza {
        background-color: #F3E8FF !important;
        color: #7E22CE !important;
        border: 1px solid #E9D5FF !important;
    }
    .badge-sim-agregado {
        background-color: #FEF3C7 !important;
        color: #B45309 !important;
        border: 1px solid #FDE68A !important;
    }
    .badge-sim-aditivo {
        background-color: #F3E8FF !important;
        color: #7E22CE !important;
        border: 1px solid #E9D5FF !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1 fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-cpu text-success" aria-hidden="true"></i>
            <span>Simulador de Resistencia con IA</span>
        </h1>
        <p class="text-secondary small mb-0">
            Estimación de resistencia a compresión (7 y 28 días) conectada al modelo <strong>VotingEnsemble</strong> en Azure Container Apps (Chile Central).
        </p>
    </div>
    <div>
        @Html.ActionLink("Volver a Mezclas", "Index", "Mezclas", null, new { @class = "btn btn-outline-secondary px-3" })
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MezclaOrigenNombre))
{
    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="status">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <span>Dosificación precargada a partir de la mezcla guardada: <strong>@Model.MezclaOrigenNombre</strong> (Id: @Model.MezclaOrigenId)</span>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.SafeDenialWarning as string))
{
    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        <span>@ViewBag.SafeDenialWarning</span>
    </div>
}

<!-- Presets de Pruebas Rápidas -->
<div class="card shadow-sm border-0 mb-4 bg-light" style="border-radius: 10px; border: 1px solid #e2e8f0 !important;">
    <div class="card-body py-2 px-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="small fw-semibold text-secondary"><i class="bi bi-magic me-1" aria-hidden="true"></i> Dosificaciones de prueba:</span>
            <button type="button" class="btn btn-sm btn-outline-success" onclick="cargarPreset('canonica')">
                <i class="bi bi-bookmark-check" aria-hidden="true"></i> Canónica (280 kg cto)
            </button>
            <button type="button" class="btn btn-sm btn-outline-success" onclick="cargarPreset('ecologica')">
                <i class="bi bi-tree" aria-hidden="true"></i> Ecológica (54.5% SCM)
            </button>
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="cargarPreset('estructural')">
                <i class="bi bi-building" aria-hidden="true"></i> Alta resistencia (360 kg cto)
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="cargarPreset('invalida')">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Inválida (Error 422)
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Formulario de Dosificación -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; border: 1px solid #e2e8f0 !important; background: #fff;">
            <div class="card-header bg-white py-3 border-0 pb-1">
                <h5 class="card-title mb-0 fw-semibold d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-sliders text-success" aria-hidden="true"></i>
                    <span>Dosificación por m³ de Concreto</span>
                </h5>
            </div>
            <div class="card-body p-4 pt-2">
                @using (Html.BeginForm("Simulador", "Mezclas", FormMethod.Post, new { id = "formSimulador" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MezclaOrigenId)
                    @Html.HiddenFor(m => m.MezclaOrigenNombre)

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Cemento, new { @class = "form-label small fw-semibold text-dark", @for = "inCemento" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Cemento, new { @class = "form-control", type = "number", step = "any", id = "inCemento", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Cemento, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Agua, new { @class = "form-label small fw-semibold text-dark", @for = "inAgua" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Agua, new { @class = "form-control", type = "number", step = "any", id = "inAgua", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Agua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.EscoriaAltoHorno, new { @class = "form-label small fw-semibold text-dark", @for = "inEscoria" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.EscoriaAltoHorno, new { @class = "form-control", type = "number", step = "any", id = "inEscoria", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.EscoriaAltoHorno, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.CenizaVolante, new { @class = "form-label small fw-semibold text-dark", @for = "inCeniza" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.CenizaVolante, new { @class = "form-control", type = "number", step = "any", id = "inCeniza", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.CenizaVolante, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.AgregadoGrueso, new { @class = "form-label small fw-semibold text-dark", @for = "inGrueso" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.AgregadoGrueso, new { @class = "form-control", type = "number", step = "any", id = "inGrueso", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.AgregadoGrueso, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.AgregadoFino, new { @class = "form-label small fw-semibold text-dark", @for = "inFino" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.AgregadoFino, new { @class = "form-control", type = "number", step = "any", id = "inFino", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.AgregadoFino, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            @Html.LabelFor(m => m.Superplastificante, new { @class = "form-label small fw-semibold text-dark", @for = "inSp" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Superplastificante, new { @class = "form-control", type = "number", step = "any", id = "inSp", oninput = "calcularTotales()" })
                                <span class="input-group-text small text-secondary">kg/m³</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.Superplastificante, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Indicadores en tiempo real -->
                    <div class="bg-light rounded-3 p-3 mt-4 border">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-secondary small">Masa total aprox.</div>
                                <div class="fw-bold fs-5 text-dark" id="lblMasaTotal">-- kg/m³</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small">Relación a/c</div>
                                <div class="fw-bold fs-5 text-dark" id="lblRelacionAc">--</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small">Sustitución SCM</div>
                                <div class="fw-bold fs-5 text-success" id="lblSustitucionScm">-- %</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-1 text-muted small mt-2">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Valores referenciales para fines académicos y experimentales.</span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" id="btnSimular" class="btn btn-success btn-lg w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 py-3">
                            <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
                            <span>Predecir resistencia con EcoMix IA</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Guía Rápida, Estados y Resultados de Inferencia -->
    <div class="col-lg-6">
        <!-- Guía rápida de componentes (Fase 3 UX) -->
        <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px; border: 1px solid #e2e8f0 !important; background: #fff;">
            <div class="card-header bg-white py-2 px-3 border-0 pb-1">
                <h6 class="card-title mb-0 fw-semibold d-flex align-items-center gap-2 text-dark" style="font-size: 0.88rem;">
                    <i class="bi bi-info-circle text-success" aria-hidden="true"></i>
                    <span>Guía rápida de componentes</span>
                </h6>
            </div>
            <div class="card-body p-2 pt-0">
                <div class="table-responsive" style="overflow-x: hidden;">
                    <table class="table table-sm align-middle mb-0" style="font-size: 0.72rem;">
                        <thead class="table-light text-uppercase text-secondary" style="font-size: 0.65rem; border-bottom: 1px solid #e2e8f0;">
                            <tr>
                                <th class="py-1 px-1" style="width: 25%;">Componente</th>
                                <th class="py-1 px-1" style="width: 28%;">Descripción</th>
                                <th class="py-1 px-1 text-center" style="width: 17%;">Rango típico (kg/m³)</th>
                                <th class="py-1 px-1" style="width: 30%;">Uso / Recomendación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-cemento">Cemento Portland</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Cementante principal (p. ej., Tipo I).</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">250 - 450</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Aporta resistencia y durabilidad.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-agua">Agua de mezclado</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Agua potable limpia.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">120 - 220</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Controla trabajabilidad y relación a/c.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-escoria">Escoria de alto horno</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">GGBFS, material cementante suplementario.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">0 - 300</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Mejora resistencia tardía y reduce CO₂.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-ceniza">Ceniza volante / Puzolana</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Fly Ash Clase F / puzolana natural.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">0 - 200</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Reduce calor de hidratación y permeabilidad.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-agregado">Agregado grueso</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Piedra chancada / grava limpia.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">900 - 1300</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Aporta volumen y soporte estructural.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-agregado">Agregado fino</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Arena gruesa seleccionada.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">600 - 900</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Rellena vacíos y mejora trabajabilidad.</td>
                            </tr>
                            <tr>
                                <td class="py-1 px-1"><span class="badge-sim-aditivo">Aditivo superplastificante</span></td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Reductor de agua de alto rango.</td>
                                <td class="py-1 px-1 text-center font-monospace fw-semibold">0 - 15</td>
                                <td class="py-1 px-1 text-secondary" style="line-height: 1.2;">Aumenta fluidez manteniendo resistencia.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Estado de Carga / Spinner -->
        <div id="panelCarga" class="card shadow-sm border-0 d-none text-center p-5 justify-content-center align-items-center mb-4" style="border-radius: 12px; border: 1px solid #e2e8f0 !important; background: #fff;">
            <div class="spinner-border text-success mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                <span class="visually-hidden">Consultando servicio ML...</span>
            </div>
            <h5 class="fw-bold mb-2 text-dark">Consultando modelo en Azure ML...</h5>
            <p class="text-secondary small mb-3" style="max-width: 400px;">
                Conectando de forma segura con <code>ca-ecomix-inference-api</code> en la región Chile Central.
            </p>
            <div class="alert alert-warning py-2 px-3 small border-0 text-start w-100" style="max-width: 420px;">
                <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
                <strong>Aviso de escala a cero:</strong> Si el contenedor estaba en reposo (0 réplicas), el arranque en frío puede tomar entre 8 y 15 segundos. Las siguientes solicitudes responderán en menos de 400 ms.
            </div>
        </div>

        <!-- Estado de Error -->
        <div id="panelError" class="card shadow-sm border-danger border-2 mb-4 @(string.IsNullOrEmpty(Model.ErrorMensaje) ? "d-none" : "")" style="border-radius: 12px;">
            <div class="card-header bg-danger text-white py-2 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <strong>Error en la predicción</strong>
            </div>
            <div class="card-body">
                <p id="txtErrorMensaje" class="mb-2 text-danger fw-semibold">@Model.ErrorMensaje</p>
                <div id="listaErroresCampos" class="@(Model.ErrorDetalle?.InvalidFields?.Any() == true ? "" : "d-none")">
                    <div class="small fw-bold text-secondary mb-1">Detalle de inconsistencias detectadas:</div>
                    <ul class="small mb-0 text-danger" id="ulErroresCampos">
                        @if (Model.ErrorDetalle?.InvalidFields != null)
                        {
                            foreach (var err in Model.ErrorDetalle.InvalidFields)
                            {
                                <li><strong>@err.Field:</strong> @err.Message</li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Estado de Resultados (Reorganizado estrictamente en 7 secciones H01-C) -->
        <div id="panelResultados" class="card shadow-sm border-0 mb-4 @(Model.Ejecutado ? "" : "d-none")" style="border-radius: 12px; border: 1px solid #e2e8f0 !important; background: #fff;">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold text-success d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>
                    <span>Resultados de Inferencia ML</span>
                </h5>
                <span class="badge text-bg-light border text-secondary" id="badgeLatencia">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i> @(Model.LatenciaMs) ms
                </span>
            </div>
            <div class="card-body">
                <!-- 1 y 2. Predicción a 7 y 28 días -->
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light text-center h-100">
                            <span class="badge text-bg-secondary mb-2">Curado Temprano</span>
                            <div class="text-secondary small fw-semibold">Resistencia a 7 días</div>
                            <div class="display-6 fw-bold text-primary my-1" id="res7d">
                                @(Model.Resultado?.Predictions?.Strength7dMpa?.ToString("0.00") ?? "--")
                            </div>
                            <div class="text-muted small">MPa</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light text-center h-100">
                            <span class="badge text-bg-success mb-2">Referencia a 28 Días</span>
                            <div class="text-secondary small fw-semibold">Resistencia a 28 días</div>
                            <div class="display-6 fw-bold text-success my-1" id="res28d">
                                @(Model.Resultado?.Predictions?.Strength28dMpa?.ToString("0.00") ?? "--")
                            </div>
                            <div class="text-muted small">MPa</div>
                        </div>
                    </div>
                </div>

                <!-- 3. Gráfico Comparativo de Resistencia (RF-18 / H01-B) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-semibold text-secondary small text-uppercase mb-0 d-flex align-items-center gap-1">
                            <i class="bi bi-bar-chart-fill text-success" aria-hidden="true"></i>
                            <span>Comparativa de Resistencia Estimada (7 vs 28 Días)</span>
                        </h6>
                        <span class="badge text-bg-light border small text-muted font-monospace" id="badgeEvolucion">
                            @if (Model.Resultado?.Predictions?.Strength28dMpa.HasValue == true && Model.Resultado.Predictions.Strength28dMpa.Value > 0 && Model.Resultado?.Predictions?.Strength7dMpa.HasValue == true)
                            {
                                var rel = (Model.Resultado.Predictions.Strength7dMpa.Value / Model.Resultado.Predictions.Strength28dMpa.Value * 100m).ToString("0.0");
                                <span>7d = @rel% de 28d</span>
                            }
                            else
                            {
                                <span>7d / 28d: --</span>
                            }
                        </span>
                    </div>

                    <div class="border rounded-3 p-3 bg-light text-center">
                        <svg id="svgGraficoResistencia" viewBox="0 0 540 230" class="w-100" style="max-height: 230px;" role="img" aria-label="Gráfico de barras comparativo de resistencia estimada a 7 y 28 días en megapascales">
                            <!-- Cuadrícula horizontal y líneas de referencia -->
                            <g id="svgGridLines" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="3 3">
                                <line x1="55" y1="35" x2="505" y2="35" />
                                <line x1="55" y1="71" x2="505" y2="71" />
                                <line x1="55" y1="107" x2="505" y2="107" />
                                <line x1="55" y1="143" x2="505" y2="143" />
                                <line x1="55" y1="179" x2="505" y2="179" stroke="#94a3b8" stroke-dasharray="none" stroke-width="1.5" />
                            </g>
                            <!-- Etiquetas del eje Y (MPa) -->
                            <g id="svgYLabels" fill="#64748b" font-size="11" text-anchor="end" font-family="system-ui, sans-serif">
                                <text x="50" y="39" id="lblYMax">@((int)maxScale)</text>
                                <text x="50" y="75" id="lblY3">@((int)(maxScale * 0.75m))</text>
                                <text x="50" y="111" id="lblY2">@((int)(maxScale * 0.50m))</text>
                                <text x="50" y="147" id="lblY1">@((int)(maxScale * 0.25m))</text>
                                <text x="50" y="183">0</text>
                                <text x="20" y="107" text-anchor="middle" transform="rotate(-90 20 107)" fill="#475569" font-size="10" font-weight="600">Resistencia (MPa)</text>
                            </g>

                            <!-- Barra 7 Días -->
                            <g id="svgGrupo7d">
                                <rect id="svgBarra7d" x="120" y="@y7Init.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" width="90" height="@h7Init.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" rx="4" fill="#0284c7" />
                                <text id="svgTextoValor7d" x="165" y="@((y7Init - 8m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="middle" font-size="13" font-weight="bold" fill="#0369a1">
                                    @(initP7.HasValue ? initP7.Value.ToString("0.00") + " MPa" : "--")
                                </text>
                                <text x="165" y="200" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">7 Días</text>
                                <text x="165" y="215" text-anchor="middle" font-size="10" fill="#64748b">Curado Inicial</text>
                            </g>

                            <!-- Barra 28 Días -->
                            <g id="svgGrupo28d">
                                <rect id="svgBarra28d" x="330" y="@y28Init.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" width="90" height="@h28Init.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" rx="4" fill="#16a34a" />
                                <text id="svgTextoValor28d" x="375" y="@((y28Init - 8m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="middle" font-size="13" font-weight="bold" fill="#15803d">
                                    @(initP28.HasValue ? initP28.Value.ToString("0.00") + " MPa" : "--")
                                </text>
                                <text x="375" y="200" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">28 Días</text>
                                <text x="375" y="215" text-anchor="middle" font-size="10" fill="#64748b">Diseño Estructural</text>
                            </g>
                        </svg>

                        <!-- Tabla complementaria para lectores de pantalla (Accesibilidad) -->
                        <table class="visually-hidden" summary="Resumen accesible de resistencia predicha">
                            <thead>
                                <tr>
                                    <th scope="col">Edad de Ensayo</th>
                                    <th scope="col">Resistencia Predicha</th>
                                    <th scope="col">Unidad</th>
                                    <th scope="col">Rol Normativo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th scope="row">7 Días</th>
                                    <td id="tdAcc7d">@(initP7?.ToString("0.00") ?? "--")</td>
                                    <td>MPa</td>
                                    <td>Control de desencofrado y curado temprano</td>
                                </tr>
                                <tr>
                                    <th scope="row">28 Días</th>
                                    <td id="tdAcc28d">@(initP28?.ToString("0.00") ?? "--")</td>
                                    <td>MPa</td>
                                    <td>Resistencia de diseño estructural f'c</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. Ratios Físicos de la Mezcla -->
                <h6 class="fw-semibold text-secondary small text-uppercase mb-2">Ratios Físicos de la Mezcla</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered align-middle small mb-0">
                        <tbody>
                            <tr>
                                <th class="table-light w-50">Relación Agua/Cemento (a/c)</th>
                                <td class="text-end fw-semibold" id="ratioAc">
                                    @(Model.Resultado?.MixRatios?.WaterCementRatio.HasValue == true
                                        ? Model.Resultado.MixRatios.WaterCementRatio.Value.ToString("0.0000")
                                        : "-- (N/A sin cemento)")
                                </td>
                            </tr>
                            <tr>
                                <th class="table-light">Relación Agua/Cementante (a/b)</th>
                                <td class="text-end fw-semibold" id="ratioAb">
                                    @(Model.Resultado?.MixRatios?.WaterBinderRatio?.ToString("0.0000") ?? "--")
                                </td>
                            </tr>
                            <tr>
                                <th class="table-light">Material Cementante Total</th>
                                <td class="text-end fw-semibold" id="ratioCementante">
                                    @(Model.Resultado?.MixRatios?.TotalCementitiousContentKgM3.HasValue == true ? Model.Resultado.MixRatios.TotalCementitiousContentKgM3.Value.ToString("0.0") + " kg/m³" : "--")
                                </td>
                            </tr>
                            <tr>
                                <th class="table-light">Sustitución de Clínker por SCM</th>
                                <td class="text-end fw-bold text-success" id="ratioScm">
                                    @(Model.Resultado?.MixRatios?.ScmReplacementPercentage.HasValue == true ? Model.Resultado.MixRatios.ScmReplacementPercentage.Value.ToString("0.00") + " %" : "--")
                                </td>
                            </tr>
                            <tr>
                                <th class="table-light">Masa Total Verificada</th>
                                <td class="text-end fw-semibold" id="ratioMasa">
                                    @(Model.Resultado?.MixRatios?.TotalMassKgM3.HasValue == true ? Model.Resultado.MixRatios.TotalMassKgM3.Value.ToString("0.0") + " kg/m³" : "--")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- 5. Advertencias Técnicas y Dominio del Modelo (H01-C) -->
                <div id="contenedorAdvertencias" class="@(Model.Resultado?.Warnings?.Any() == true ? "" : "d-none") mb-4">
                    <h6 class="fw-semibold text-secondary small text-uppercase mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-shield-exclamation text-warning" aria-hidden="true"></i>
                        <span>Advertencias Técnicas y Dominio del Modelo</span>
                    </h6>
                    <div id="listaAdvertencias">
                        @if (Model.Resultado?.Warnings != null)
                        {
                            foreach (var w in Model.Resultado.Warnings)
                            {
                                var isOod = w.Code != null && w.Code.StartsWith("WARN_OOD_", StringComparison.OrdinalIgnoreCase);
                                var alertClass = isOod ? "alert-warning border-warning" : (w.Severity == "info" ? "alert-info border-info" : "alert-warning border-warning");
                                var badgeClass = isOod ? "bg-warning text-dark" : (w.Severity == "info" ? "bg-info text-dark" : "bg-warning text-dark");
                                var badgeText = isOod ? "Extrapolación OOD" : "Recomendación Tecnológica";
                                <div class="alert @alertClass py-2 px-3 small mb-2">
                                    <div class="d-flex align-items-center gap-1 mb-1 fw-bold">
                                        <span class="badge @badgeClass">@badgeText</span>
                                        <span class="font-monospace small">[@w.Code]</span>
                                        @if (!string.IsNullOrEmpty(w.Field))
                                        {
                                            <span>@w.Field</span>
                                        }
                                        @if (!string.IsNullOrEmpty(w.ReferenceBoundary))
                                        {
                                            <span class="text-secondary fw-normal ms-1">(Límite ref: @w.ReferenceBoundary)</span>
                                        }
                                    </div>
                                    <div class="text-secondary">@w.Message</div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- 6. Metadatos del Modelo y Trazabilidad -->
                <div class="border-top pt-3 small text-secondary">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Algoritmo:</span>
                        <span class="fw-semibold text-dark" id="metaModelo">@(Model.Resultado?.Metadata?.ModelType ?? "VotingEnsemble")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>ID Experimento:</span>
                        <span class="font-monospace text-dark" id="metaId">@(Model.Resultado?.Metadata?.ModelId ?? "wheat_cheese_4swj34tkjn_11")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Hash SHA-256:</span>
                        <span class="font-monospace small text-dark" id="metaSha" title="@(Model.Resultado?.Metadata?.ModelSha256)">
                            @(Model.Resultado?.Metadata?.ModelSha256 != null && Model.Resultado.Metadata.ModelSha256.Length >= 12 ? Model.Resultado.Metadata.ModelSha256.Substring(0, 12) + "..." : "--")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Marca Temporal UTC:</span>
                        <span class="font-monospace small text-dark" id="metaTimestamp">@(Model.Resultado?.Metadata?.InferenceTimestamp ?? "--")</span>
                    </div>
                </div>

                <!-- 7. Aviso de Uso Orientativo (Disclaimer) -->
                <div class="alert alert-light border small text-muted mb-0 mt-3 p-2">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    <strong>Aviso Técnico y Limitaciones:</strong> Las estimaciones corresponden a inferencias estadísticas del modelo VotingEnsemble (R² = 0.912) calibrado con el dataset UCI 165. Estos valores tienen carácter referencial y académico; no sustituyen el diseño empírico ni los ensayos normalizados de laboratorio (NTP 339.034 / ASTM C39).
                </div>
            </div>
        </div>

        <!-- Placeholder Inicial si no se ha ejecutado (Fase 3 UX) -->
        <div id="panelPlaceholder" class="card shadow-sm border-0 text-center p-4 justify-content-center align-items-center mb-4 @(Model.Ejecutado || !string.IsNullOrEmpty(Model.ErrorMensaje) ? "d-none" : "")" style="border-radius: 12px; border: 1px solid #e2e8f0 !important; background: #fff; min-height: 180px;">
            <i class="bi bi-cpu text-muted mb-2" style="font-size: 2.75rem;" aria-hidden="true"></i>
            <h5 class="fw-semibold text-dark mb-1">Predicción de resistencia</h5>
            <p class="text-secondary small mb-0" style="max-width: 440px;">
                El modelo de IA estimará la resistencia a compresión del concreto a los 7 y 28 días (en MPa) según la dosificación ingresada.
            </p>
        </div>
    </div>
</div>

<script>
    var isSubmitting = false;

    var presets = {
        canonica: {
            cemento: 280.0,
            escoria: 0.0,
            ceniza: 0.0,
            agua: 180.0,
            sp: 0.0,
            grueso: 1050.0,
            fino: 750.0
        },
        ecologica: {
            cemento: 150.0,
            escoria: 100.0,
            ceniza: 80.0,
            agua: 165.0,
            sp: 5.0,
            grueso: 1000.0,
            fino: 750.0
        },
        estructural: {
            cemento: 360.0,
            escoria: 60.0,
            ceniza: 0.0,
            agua: 160.0,
            sp: 6.0,
            grueso: 1020.0,
            fino: 740.0
        },
        invalida: {
            cemento: -10.0,
            escoria: 0.0,
            ceniza: 0.0,
            agua: 180.0,
            sp: 0.0,
            grueso: 1050.0,
            fino: 750.0
        }
    };

    function cargarPreset(nombre) {
        var p = presets[nombre];
        if (!p) return;

        document.getElementById('inCemento').value = p.cemento;
        document.getElementById('inEscoria').value = p.escoria;
        document.getElementById('inCeniza').value = p.ceniza;
        document.getElementById('inAgua').value = p.agua;
        document.getElementById('inSp').value = p.sp;
        document.getElementById('inGrueso').value = p.grueso;
        document.getElementById('inFino').value = p.fino;

        calcularTotales();
    }

    function calcularTotales() {
        var c = parseFloat(document.getElementById('inCemento').value) || 0;
        var s = parseFloat(document.getElementById('inEscoria').value) || 0;
        var f = parseFloat(document.getElementById('inCeniza').value) || 0;
        var w = parseFloat(document.getElementById('inAgua').value) || 0;
        var sp = parseFloat(document.getElementById('inSp').value) || 0;
        var g = parseFloat(document.getElementById('inGrueso').value) || 0;
        var a = parseFloat(document.getElementById('inFino').value) || 0;

        var masaTotal = c + s + f + w + sp + g + a;
        var binder = c + s + f;
        var scmPct = binder > 0 ? ((s + f) / binder * 100) : 0;
        var ac = c > 0 ? (w / c) : null;

        document.getElementById('lblMasaTotal').textContent = masaTotal.toFixed(1) + ' kg/m³';
        document.getElementById('lblRelacionAc').textContent = ac !== null ? ac.toFixed(3) : '-- (sin cemento)';
        document.getElementById('lblSustitucionScm').textContent = scmPct.toFixed(1) + ' %';
    }

    function actualizarGraficoResistencia(p7, p28) {
        var num7 = (p7 !== null && p7 !== undefined && !isNaN(p7)) ? Number(p7) : null;
        var num28 = (p28 !== null && p28 !== undefined && !isNaN(p28)) ? Number(p28) : null;

        var maxVal = Math.max(50, Math.ceil(Math.max(num7 || 0, num28 || 0) / 10) * 10);
        var plotHeight = 144;
        var baseY = 179;

        var elYMax = document.getElementById("lblYMax");
        var elY3 = document.getElementById("lblY3");
        var elY2 = document.getElementById("lblY2");
        var elY1 = document.getElementById("lblY1");

        if (elYMax) elYMax.textContent = maxVal;
        if (elY3) elY3.textContent = Math.round(maxVal * 0.75);
        if (elY2) elY2.textContent = Math.round(maxVal * 0.50);
        if (elY1) elY1.textContent = Math.round(maxVal * 0.25);

        var b7 = document.getElementById("svgBarra7d");
        var t7 = document.getElementById("svgTextoValor7d");
        var td7 = document.getElementById("tdAcc7d");
        if (b7 && t7) {
            if (num7 !== null) {
                var h7 = Math.max(0, (num7 / maxVal) * plotHeight);
                var y7 = baseY - h7;
                b7.setAttribute("y", y7.toFixed(1));
                b7.setAttribute("height", h7.toFixed(1));
                t7.setAttribute("y", (y7 - 8).toFixed(1));
                t7.textContent = num7.toFixed(2) + " MPa";
                if (td7) td7.textContent = num7.toFixed(2);
            } else {
                b7.setAttribute("y", baseY.toString());
                b7.setAttribute("height", "0");
                t7.setAttribute("y", (baseY - 8).toString());
                t7.textContent = "--";
                if (td7) td7.textContent = "--";
            }
        }

        var b28 = document.getElementById("svgBarra28d");
        var t28 = document.getElementById("svgTextoValor28d");
        var td28 = document.getElementById("tdAcc28d");
        if (b28 && t28) {
            if (num28 !== null) {
                var h28 = Math.max(0, (num28 / maxVal) * plotHeight);
                var y28 = baseY - h28;
                b28.setAttribute("y", y28.toFixed(1));
                b28.setAttribute("height", h28.toFixed(1));
                t28.setAttribute("y", (y28 - 8).toFixed(1));
                t28.textContent = num28.toFixed(2) + " MPa";
                if (td28) td28.textContent = num28.toFixed(2);
            } else {
                b28.setAttribute("y", baseY.toString());
                b28.setAttribute("height", "0");
                t28.setAttribute("y", (baseY - 8).toString());
                t28.textContent = "--";
                if (td28) td28.textContent = "--";
            }
        }

        var badgeEvol = document.getElementById("badgeEvolucion");
        if (badgeEvol) {
            if (num7 !== null && num28 !== null && num28 > 0) {
                var rel = (num7 / num28 * 100).toFixed(1);
                badgeEvol.textContent = "7d = " + rel + "% de 28d";
            } else {
                badgeEvol.textContent = "7d / 28d: --";
            }
        }
    }

    function limpiarGraficoResistencia() {
        actualizarGraficoResistencia(null, null);
    }

    document.addEventListener("DOMContentLoaded", function () {
        calcularTotales();

        var form = document.getElementById("formSimulador");
        if (!form) return;

        form.addEventListener("submit", function (e) {
            e.preventDefault();

            if (isSubmitting) {
                return;
            }
            isSubmitting = true;

            var panelCarga = document.getElementById("panelCarga");
            var panelError = document.getElementById("panelError");
            var panelResultados = document.getElementById("panelResultados");
            var panelPlaceholder = document.getElementById("panelPlaceholder");
            var btnSimular = document.getElementById("btnSimular");

            panelCarga.classList.remove("d-none");
            panelError.classList.add("d-none");
            panelResultados.classList.add("d-none");
            panelPlaceholder.classList.add("d-none");
            limpiarGraficoResistencia();
            btnSimular.disabled = true;

            var formData = new FormData(form);

            fetch('@Url.Action("SimularAjax", "Mezclas")', {
                method: 'POST',
                body: formData
            })
            .then(function (response) {
                return response.json().then(function (data) {
                    return { ok: response.ok, status: response.status, data: data };
                }).catch(function () {
                    return { ok: response.ok, status: response.status, data: { success: false, error: "Respuesta del servidor con formato no válido (HTTP " + response.status + ")." } };
                });
            })
            .then(function (result) {
                panelCarga.classList.add("d-none");
                btnSimular.disabled = false;
                isSubmitting = false;

                var res = result.data;

                if (result.ok && res && res.success && res.data) {
                    var d = res.data;

                    // 1 y 2. Predicciones (soporte snake_case y PascalCase)
                    var pred = d.predictions || d.Predictions || {};
                    var p7Raw = pred.strength_7d_mpa !== undefined ? pred.strength_7d_mpa : pred.Strength7dMpa;
                    var p28Raw = pred.strength_28d_mpa !== undefined ? pred.strength_28d_mpa : pred.Strength28dMpa;

                    var p7 = (p7Raw !== null && p7Raw !== undefined && !isNaN(p7Raw)) ? Number(p7Raw) : null;
                    var p28 = (p28Raw !== null && p28Raw !== undefined && !isNaN(p28Raw)) ? Number(p28Raw) : null;

                    document.getElementById("res7d").textContent = (p7 !== null) ? p7.toFixed(2) : "--";
                    document.getElementById("res28d").textContent = (p28 !== null) ? p28.toFixed(2) : "--";

                    // 3. Gráfico SVG nativo accesible
                    actualizarGraficoResistencia(p7, p28);

                    // 4. Ratios de la mezcla
                    var ratios = d.mix_ratios || d.MixRatios || {};
                    var w_c = ratios.water_cement_ratio !== undefined ? ratios.water_cement_ratio : ratios.WaterCementRatio;
                    var w_b = ratios.water_binder_ratio !== undefined ? ratios.water_binder_ratio : ratios.WaterBinderRatio;
                    var totalCement = ratios.total_cementitious_content_kg_m3 !== undefined ? ratios.total_cementitious_content_kg_m3 : ratios.TotalCementitiousContentKgM3;
                    var scmPct = ratios.scm_replacement_percentage !== undefined ? ratios.scm_replacement_percentage : ratios.ScmReplacementPercentage;
                    var totalMass = ratios.total_mass_kg_m3 !== undefined ? ratios.total_mass_kg_m3 : ratios.TotalMassKgM3;

                    var ratioAcEl = document.getElementById("ratioAc");
                    if (w_c !== null && w_c !== undefined && !isNaN(w_c)) {
                        ratioAcEl.textContent = Number(w_c).toFixed(4);
                    } else {
                        ratioAcEl.textContent = "-- (N/A sin cemento)";
                    }

                    document.getElementById("ratioAb").textContent = (w_b !== null && w_b !== undefined && !isNaN(w_b)) ? Number(w_b).toFixed(4) : "--";
                    document.getElementById("ratioCementante").textContent = (totalCement !== null && totalCement !== undefined && !isNaN(totalCement)) ? Number(totalCement).toFixed(1) + " kg/m³" : "--";
                    document.getElementById("ratioScm").textContent = (scmPct !== null && scmPct !== undefined && !isNaN(scmPct)) ? Number(scmPct).toFixed(2) + " %" : "--";
                    document.getElementById("ratioMasa").textContent = (totalMass !== null && totalMass !== undefined && !isNaN(totalMass)) ? Number(totalMass).toFixed(1) + " kg/m³" : "--";
                    document.getElementById("badgeLatencia").textContent = (res.latencyMs || 0) + " ms";

                    // 5. Advertencias estructuradas (Seguras con nodos DOM, sin innerHTML)
                    var contAdv = document.getElementById("contenedorAdvertencias");
                    var listaAdv = document.getElementById("listaAdvertencias");
                    while (listaAdv.firstChild) {
                        listaAdv.removeChild(listaAdv.firstChild);
                    }

                    var warnings = d.warnings || d.Warnings || [];
                    if (warnings.length > 0) {
                        contAdv.classList.remove("d-none");
                        warnings.forEach(function (w) {
                            var code = String(w.code || w.Code || "");
                            var severity = String(w.severity || w.Severity || "warning").toLowerCase();
                            var field = String(w.field || w.Field || "");
                            var boundary = String(w.reference_boundary || w.ReferenceBoundary || "");
                            var message = String(w.message || w.Message || "");

                            var isOod = code.toUpperCase().indexOf("WARN_OOD_") === 0;

                            var div = document.createElement("div");
                            div.className = isOod
                                ? "alert alert-warning py-2 px-3 small mb-2 border-warning"
                                : (severity === "info" ? "alert alert-info py-2 px-3 small mb-2 border-info" : "alert alert-warning py-2 px-3 small mb-2 border-warning");

                            var headerDiv = document.createElement("div");
                            headerDiv.className = "d-flex align-items-center gap-1 mb-1 fw-bold";

                            var badge = document.createElement("span");
                            badge.className = isOod ? "badge bg-warning text-dark" : (severity === "info" ? "badge bg-info text-dark" : "badge bg-warning text-dark");
                            badge.textContent = isOod ? "Extrapolación OOD" : "Recomendación Tecnológica";
                            headerDiv.appendChild(badge);

                            var codeSpan = document.createElement("span");
                            codeSpan.className = "font-monospace small";
                            codeSpan.textContent = "[" + code + "]";
                            headerDiv.appendChild(codeSpan);

                            if (field) {
                                var fieldSpan = document.createElement("span");
                                fieldSpan.textContent = " " + field;
                                headerDiv.appendChild(fieldSpan);
                            }

                            if (boundary) {
                                var boundSpan = document.createElement("span");
                                boundSpan.className = "text-secondary fw-normal ms-1";
                                boundSpan.textContent = "(Límite ref: " + boundary + ")";
                                headerDiv.appendChild(boundSpan);
                            }

                            div.appendChild(headerDiv);

                            var msgDiv = document.createElement("div");
                            msgDiv.className = "text-secondary";
                            msgDiv.textContent = message;
                            div.appendChild(msgDiv);

                            listaAdv.appendChild(div);
                        });
                    } else {
                        contAdv.classList.add("d-none");
                    }

                    // 6. Metadatos del modelo
                    var meta = d.metadata || d.Metadata || {};
                    document.getElementById("metaModelo").textContent = meta.model_type || meta.ModelType || "VotingEnsemble";
                    document.getElementById("metaId").textContent = meta.model_id || meta.ModelId || "wheat_cheese_4swj34tkjn_11";
                    var sha = meta.model_sha256 || meta.ModelSha256 || "";
                    var metaShaEl = document.getElementById("metaSha");
                    if (sha) {
                        metaShaEl.textContent = sha.length >= 12 ? sha.substring(0, 12) + "..." : sha;
                        metaShaEl.title = sha;
                    } else {
                        metaShaEl.textContent = "--";
                    }
                    document.getElementById("metaTimestamp").textContent = meta.inference_timestamp || meta.InferenceTimestamp || "--";

                    panelResultados.classList.remove("d-none");
                } else {
                    panelResultados.classList.add("d-none");
                    limpiarGraficoResistencia();
                    panelError.classList.remove("d-none");

                    var errText = (res && (res.error || res.message)) ? (res.error || res.message) : ("Error en la solicitud (Código HTTP " + result.status + ")");
                    document.getElementById("txtErrorMensaje").textContent = errText;

                    var listaCampos = document.getElementById("listaErroresCampos");
                    var ulCampos = document.getElementById("ulErroresCampos");
                    while (ulCampos.firstChild) {
                        ulCampos.removeChild(ulCampos.firstChild);
                    }

                    var details = res ? (res.details || res.Details || res.problemDetails) : null;
                    var invalidFields = (details && (details.invalid_fields || details.InvalidFields)) ? (details.invalid_fields || details.InvalidFields) : null;

                    if (invalidFields && invalidFields.length > 0) {
                        listaCampos.classList.remove("d-none");
                        invalidFields.forEach(function (f) {
                            var fName = String(f.field || f.Field || "");
                            var fMsg = String(f.message || f.Message || "");

                            var li = document.createElement("li");
                            var strong = document.createElement("strong");
                            strong.textContent = fName ? (fName + ": ") : "";
                            li.appendChild(strong);
                            li.appendChild(document.createTextNode(fMsg));
                            ulCampos.appendChild(li);
                        });
                    } else if (res && res.validationErrors && res.validationErrors.length > 0) {
                        listaCampos.classList.remove("d-none");
                        res.validationErrors.forEach(function (err) {
                            var li = document.createElement("li");
                            li.textContent = String(err);
                            ulCampos.appendChild(li);
                        });
                    } else {
                        listaCampos.classList.add("d-none");
                    }
                }
            })
            .catch(function (err) {
                panelCarga.classList.add("d-none");
                panelResultados.classList.add("d-none");
                limpiarGraficoResistencia();
                btnSimular.disabled = false;
                isSubmitting = false;

                panelError.classList.remove("d-none");
                document.getElementById("txtErrorMensaje").textContent = "Error de comunicación o tiempo de espera agotado al consultar el servidor local: " + err.message;
            });
        });
    });
</script>
