﻿@model EcomixIA.Models.Mezcla

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<div class="row g-3">
    <div class="col-md-6">
        @Html.LabelFor(m => m.Nombre, htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-3">
        @Html.LabelFor(m => m.ResistenciaMPa, htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(m => m.ResistenciaMPa, new { htmlAttributes = new { @class = "form-control", step = "any" } })
        @Html.ValidationMessageFor(m => m.ResistenciaMPa, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-3">
        @Html.LabelFor(m => m.EdadDias, htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(m => m.EdadDias, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.EdadDias, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-3">
        @Html.LabelFor(m => m.RelacionAguaCemento, htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(m => m.RelacionAguaCemento, new { htmlAttributes = new { @class = "form-control", step = "any" } })
        @Html.ValidationMessageFor(m => m.RelacionAguaCemento, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-3">
        @Html.LabelFor(m => m.AsentamientoCm, htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(m => m.AsentamientoCm, new { htmlAttributes = new { @class = "form-control", step = "any" } })
        @Html.ValidationMessageFor(m => m.AsentamientoCm, "", new { @class = "text-danger small" })
    </div>
    <div class="col-12">
        @Html.LabelFor(m => m.Notas, htmlAttributes: new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Notas, new { @class = "form-control", rows = 3 })
        @Html.ValidationMessageFor(m => m.Notas, "", new { @class = "text-danger small" })
    </div>
</div>
